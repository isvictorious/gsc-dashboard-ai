# Google Cloud credentials
*.json
service-account*.json
credentials*.json
gcloud/

# Table schemas contain no secrets - keep them tracked despite *.json above
!schemas/*.json

# Environment files
.env
.env.*
config/project.env
*.env

# macOS
.DS_Store

# Editor
.vscode/*
# Shared project editor config stays tracked
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp

# Python virtual environment
.venv/
__pycache__/
*.pyc

# Logs
*.log
logs/

# Temp files from BigQuery exports
*.csv
*.tsv
